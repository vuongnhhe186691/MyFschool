@page
@model PRM_PRJ.Pages.Admin.TimetablesModel
@{
    ViewData["Title"] = "Quản lý Thời khóa biểu";
}

<div class="alert alert-info small d-flex align-items-center mb-3">
    <i class="bi bi-info-circle-fill me-2"></i>
    <span>Quy định học vụ: Chỉ cho phép tạo mới hoặc import thời khóa biểu (không sửa/xóa bản ghi cũ) và tự động kiểm tra trùng tiết của lớp.</span>
</div>

<div class="card card-fpt mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Lọc theo Lớp</label>
                <select name="ClassId" class="form-select">
                    <option value="">Tất cả các lớp</option>
                    @foreach (var c in Model.Classes)
                    {
                        <option value="@c.Id" selected="@(Model.ClassId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Tuần bắt đầu (trong DB)</label>
                <select name="WeekStartDate" class="form-select">
                    <option value="">Tất cả các tuần</option>
                    @foreach (var w in Model.AvailableWeeks)
                    {
                        <option value="@w" selected="@(Model.WeekStartDate == w)">@w</option>
                    }
                </select>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-fpt"><i class="bi bi-search me-1"></i> Lọc</button>
                <a asp-page="/Admin/Timetables" class="btn btn-outline-secondary">Tất cả</a>
                <button type="button" class="btn btn-success ms-auto" data-bs-toggle="modal" data-bs-target="#createTimetableModal">
                    <i class="bi bi-plus-circle me-1"></i> Thêm tiết học
                </button>
                <button type="button" class="btn btn-outline-fpt" data-bs-toggle="modal" data-bs-target="#importTimetableModal">
                    <i class="bi bi-file-earmark-excel me-1"></i> Import Excel
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card card-fpt">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">Danh sách Thời khóa biểu (@Model.TotalItems tiết)</h6>
        <span class="small text-muted">Trang @Model.PageNumber / @Model.TotalPages</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Lớp</th>
                    <th>Tuần</th>
                    <th>Thứ</th>
                    <th>Giờ học</th>
                    <th>Môn học</th>
                    <th>Giáo viên</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Timetables)
                {
                    <tr>
                        <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@t.ClassName</span></td>
                        <td class="text-muted small">@t.WeekStartDate</td>
                        <td class="fw-semibold">@t.DayOfWeek</td>
                        <td><span class="badge bg-warning-subtle text-dark border border-warning-subtle">@t.StartTime - @t.EndTime</span></td>
                        <td class="fw-medium">@t.SubjectName</td>
                        <td>@t.TeacherName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="small text-muted">
                Hiển thị @Model.Timetables.Count / @Model.TotalItems tiết học
            </div>
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Admin/Timetables" asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-ClassId="@Model.ClassId" asp-route-WeekStartDate="@Model.WeekStartDate">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (var p = Model.StartPage; p <= Model.EndPage; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-page="/Admin/Timetables" asp-route-PageNumber="@p"
                               asp-route-ClassId="@Model.ClassId" asp-route-WeekStartDate="@Model.WeekStartDate">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/Admin/Timetables" asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-ClassId="@Model.ClassId" asp-route-WeekStartDate="@Model.WeekStartDate">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Create Timetable Modal -->
<div class="modal fade" id="createTimetableModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thêm lịch học mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lớp *</label>
                        <select name="Input.ClassId" class="form-select" required>
                            @foreach (var c in Model.Classes)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Môn học *</label>
                        <select name="Input.SubjectId" class="form-select" required>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Giáo viên *</label>
                        <select name="Input.TeacherId" class="form-select" required>
                            @foreach (var tc in Model.Teachers)
                            {
                                <option value="@tc.Id">@tc.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Thứ trong tuần *</label>
                            <select name="Input.DayOfWeek" class="form-select" required>
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                                <option value="Saturday">Saturday</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Ngày đầu tuần *</label>
                            <input type="date" name="Input.WeekStartDate"
                                   value="@(Model.AvailableWeeks.FirstOrDefault() ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                                   class="form-control" required />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Giờ bắt đầu (HH:mm) *</label>
                            <input type="time" name="Input.StartTime" value="07:00" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Giờ kết thúc (HH:mm) *</label>
                            <input type="time" name="Input.EndTime" value="07:45" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-fpt">Tạo lịch học</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Timetable Modal -->
<div class="modal fade" id="importTimetableModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Import" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-file-earmark-excel text-success me-2"></i>Import Thời khóa biểu từ Excel
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        <div class="fw-semibold mb-1">Cấu trúc các cột trong file Excel (.xlsx / .csv):</div>
                        <code>Class | Subject | Teacher | DayOfWeek | StartTime | EndTime | WeekStartDate</code>
                        <div class="mt-2 text-muted">
                            Ví dụ: <code>10A1 | Toán | Nguyen Van An | Monday | 10:20 | 11:05 | 2026-03-23</code>
                            (hỗ trợ nhập Tên hoặc ID cho Lớp, Môn học, Giáo viên).
                        </div>
                    </div>

                    <div class="mb-3">
                        <a asp-page="/Admin/Timetables" asp-page-handler="DownloadTemplate" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-download me-1"></i> Tải file Excel mẫu (.xlsx)
                        </a>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Chọn file Excel (.xlsx hoặc .csv) *</label>
                        <input type="file" name="excelFile" accept=".xlsx,.csv" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-fpt">
                        <i class="bi bi-upload me-1"></i> Import dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
