@page
@model PRM_PRJ.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - MyFSchool Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        @@keyframes floatLogo {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }

        @@keyframes cardReveal {
            from { opacity: 0; transform: translateY(22px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        body {
            background: radial-gradient(circle at top left, #FFF4E8 0%, #FFE0C2 45%, #F8FAFC 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            padding: 1rem;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(16px);
            border-radius: 26px;
            padding: 2.5rem;
            box-shadow: 0 24px 60px rgba(243, 112, 33, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.8);
            animation: cardReveal 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        .app-logo {
            width: 76px;
            height: 76px;
            border-radius: 22px;
            background: linear-gradient(135deg, #FFA229, #F37021);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.3rem;
            margin: 0 auto 1.1rem;
            box-shadow: 0 12px 24px rgba(243, 112, 33, 0.34);
            animation: floatLogo 3s ease-in-out infinite;
        }

        .btn-fpt {
            background: linear-gradient(135deg, #FF942E, #F37021);
            border: none;
            color: #fff;
            font-weight: 700;
            padding: 0.78rem;
            border-radius: 14px;
            transition: all 0.2s ease;
        }

        .btn-fpt:hover {
            background: linear-gradient(135deg, #F37021, #D95B12);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(243, 112, 33, 0.32);
        }

        .input-group-text {
            background: #FFF7F0;
            color: #F37021;
            border-color: #E2E8F0;
            border-radius: 12px 0 0 12px;
        }

        .form-control {
            border-color: #E2E8F0;
            padding: 0.7rem 0.9rem;
        }

        .form-control:focus {
            border-color: #F37021;
            box-shadow: 0 0 0 0.2rem rgba(243, 112, 33, 0.18);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="app-logo">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">My FSchool</h3>
            <p class="text-muted small mb-0">Cổng Quản Trị Viên (Razor Pages)</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small d-flex align-items-center">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold small">Số điện thoại</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-phone-fill"></i></span>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="PhoneNumber (vd: 0900000000)" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" type="password" id="pwdInput" class="form-control" placeholder="Password" required />
                    <button type="button" class="btn btn-outline-secondary" onclick="togglePwd()">
                        <i class="bi bi-eye-fill" id="pwdEye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-fpt w-100 mt-2">Login</button>
        </form>
    </div>

    <script>
        function togglePwd() {
            const input = document.getElementById('pwdInput');
            const eye = document.getElementById('pwdEye');
            if (input.type === 'password') {
                input.type = 'text';
                eye.className = 'bi bi-eye-slash-fill';
            } else {
                input.type = 'password';
                eye.className = 'bi bi-eye-fill';
            }
        }
    </script>
</body>
</html>
